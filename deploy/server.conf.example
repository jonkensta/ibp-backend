# IBP backend production configuration (native install on ibp-server).
#
# Install as /home/jstarr/ibp-new/server.conf (mode 0600, owned by jstarr).
# ibp-backend.service points CONF at that path. server.conf is gitignored.
#
# Values may use ${VAR} (required) or ${VAR:-default} environment
# substitution. Plain "%" is not allowed outside the [logging] format line.
#
# Secrets: the new app reads none. The legacy [server] secret_key and apikey
# are not used, so leave them out and never reuse the legacy apikey.

[database]
# Absolute path: four slashes after the scheme. SQLite writes its -journal
# (or -wal/-shm) file next to the database, so the directory holding it must
# be writable by the service (see ReadWritePaths in ibp-backend.service).
uri = sqlite+aiosqlite:////home/jstarr/ibp-new/data.db

[logging]
level = INFO
# Empty logfile: log to stderr, which systemd sends to the journal
# (journalctl -u ibp-backend). A relative path is resolved against this
# config file's directory.
logfile =
# Only used when logfile is set: rotate at max_bytes and keep backup_count
# old files, so at most max_bytes * (backup_count + 1) bytes are used.
max_bytes = 10485760
backup_count = 5
# journald adds its own timestamps.
format = [%(levelname)s] %(name)s: %(message)s

[providers]
# Seconds allowed for each provider (TDCJ, FBOP) curl request. A name search
# can make up to four requests one after another, so nginx's
# proxy_read_timeout must stay well above 4x this value.
timeout = 5.0

[warnings]
# Warn when the inmate's release date is fewer than this many days away.
min_release_timedelta = 60
# Warn when the last filled request was postmarked fewer than this many days
# before the new one.
min_postmark_timedelta = 90
# Hours before cached inmate data is fetched again from the providers.
inmates_cache_ttl = 24
