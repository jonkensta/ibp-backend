# Image tag for both ibp-backend and ibp-frontend: a release tag such as
# v1.0.0 in production, or "main" for testing. Copy to .env.
IBP_TAG=main

# Host user that owns ./data (defaults to 1000:1000, the first user on
# Raspberry Pi OS). Check with: id -u; id -g
# IBP_UID=1000
# IBP_GID=1000

# ISBN lookup keys (GET /api/books/{isbn}), from Bitwarden. All optional;
# see sample.conf [books]. .env holds secrets once these are set: keep it
# mode 0600.
# ISBNDB_KEY=        # Bitwarden "ISBNDB", field apikey
# GOOGLE_BOOKS_KEY=  # Bitwarden "accounts.google.com", field books-apikey
# ANTHROPIC_API_KEY= # Bitwarden "Claude", field ibp-book-lookup-api-key
